{
  "name": "@linonward/www",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @linonward/contracts build",
    "dev": "next dev",
    "prebuild": "pnpm --filter @linonward/contracts build",
    "build": "next build",
    "start": "next start",
    "pretypecheck": "pnpm --filter @linonward/contracts build",
    "typecheck": "next typegen && tsc --noEmit",
    "pretest": "pnpm --filter @linonward/contracts build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "clean": "rm -rf .next .turbo node_modules"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@linonward/contracts": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@linonward/typescript-config": "workspace:*",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "shadcn": "^4.19.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
