# Copy to apps/www/.env.local — that file is gitignored.

# Origin of apps/api, which the contact form posts to from the browser. Bare
# origin: scheme, host, and port, no path.
#
# Two things to know:
#   - It is inlined at `next build` and frozen there, so one built image cannot
#     be promoted between environments. Set it per build.
#   - The browser calls it directly, so this origin must also appear in the
#     API's CORS_ALLOWED_ORIGINS — the other side of the same handshake.
#
# Leave unset and it falls back to http://localhost:3001, the API's own default
# port, so `pnpm dev` in both workspaces works with no configuration.
NEXT_PUBLIC_API_URL=http://localhost:3001
