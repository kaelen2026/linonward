# Feishu self-built app credentials used to establish the long connection.
FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace-with-feishu-app-secret
FEISHU_ALLOWED_OPEN_IDS=ou_replace_with_an_authorized_sender

# Optional: archive every message from one topic group into a Bitable whose
# fields are named 内容 (text), 附件 (attachment), and 时间 (date).
# Configure all three values together and grant the app Bitable/Drive write access.
# FEISHU_BITABLE_CHAT_ID=oc_replace_with_topic_group_chat_id
# FEISHU_BITABLE_APP_TOKEN=bascn_replace_with_base_app_token
# FEISHU_BITABLE_TABLE_ID=tbl_replace_with_table_id

# Shared, expiring message claims prevent duplicate dispatches across restarts and replicas.
REDIS_URL=redis://redis:6379
# Feishu tasks are durably recorded here before GitHub/Hermes side effects.
DATABASE_URL=postgres://linonward:linonward@localhost:5432/linonward

# A fine-grained GitHub token scoped to this repository, with Actions: write.
# It dispatches the linonward-bot workflow and is never passed to that workflow.
GITHUB_DISPATCH_TOKEN=github_pat_replace_me
GITHUB_REPOSITORY=kaelen2026/linonward
# EXTERNAL_REQUEST_TIMEOUT_MS=30000

# Defaults shown here; set these only when dispatching a different workflow/ref.
# GITHUB_WORKFLOW=linonward-bot.yml
# GITHUB_WORKFLOW_REF=main

# Set only for GitHub Enterprise Server.
# GITHUB_API_URL=https://github.example.com/api/v3

# Optional local Hermes content-production API. With these configured, send
# `/内容 <需求>` or `/content <request>` to the same Feishu bot.
# HERMES_API_URL=http://host.docker.internal:8642/v1
# HERMES_API_KEY=replace-with-a-local-hermes-api-key
# HERMES_MODEL=contentchief
