<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>LinOnward</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.linonward.app.article</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>linonward</string>
			</array>
		</dict>
	</array>
	<key>LinOnwardAPIBaseURL</key>
	<string>$(LINONWARD_API_BASE_URL)</string>
	<!-- A WKWebView carrying the native bridge may load only this exact origin.
	     Release leaves it empty until the pipeline supplies an approved HTTPS
	     URL; Debug uses localhost for the Vite development server. -->
	<key>LinOnwardArticleReaderURL</key>
	<string>$(LINONWARD_ARTICLE_READER_URL)</string>
	<!-- Optional immutable Hybrid release channel. Empty disables remote code
	     updates while preserving the bundled reader. -->
	<key>LinOnwardHybridChannelURL</key>
	<string>$(LINONWARD_HYBRID_CHANNEL_URL)</string>
	<!-- The app's own Google OAuth client; empty hides the Google button. Not a
	     secret: a native OAuth client is a public client, which is exactly why
	     the flow proves itself with PKCE and holds no client secret. No
	     CFBundleURLTypes entry belongs with it — ASWebAuthenticationSession
	     intercepts the reversed-client-id redirect itself rather than reopening
	     the app through the URL scheme. -->
	<key>LinOnwardGoogleClientID</key>
	<string>$(LINONWARD_GOOGLE_CLIENT_ID)</string>
	<!-- Lets a Simulator build reach the API over plain HTTP on localhost.
	     NSAllowsLocalNetworking is scoped to loopback and .local addresses, so
	     App Transport Security still applies in full to every internet host —
	     unlike NSAllowsArbitraryLoads, which would disable it everywhere. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
