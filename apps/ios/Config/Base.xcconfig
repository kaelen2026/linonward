MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1,2

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES

CODE_SIGN_STYLE = Automatic
ENABLE_USER_SCRIPT_SANDBOXING = YES

// Origin of `apps/api`, baked into Info.plist at build time — the same
// contract as NEXT_PUBLIC_API_URL in the web workspaces. `//` starts a comment
// in an xcconfig, so the scheme separator has to be broken up with `$()`.
// The default matches the API's own default port, so a Simulator build talks
// to `pnpm --filter @linonward/api dev` with no configuration at all.
LINONWARD_API_BASE_URL = http:/$()/localhost:3001

// The app's Google OAuth client — an iOS client in the same Google project as
// the web one, because Google refuses to redirect a web client to a custom URL
// scheme. Empty by default, in every configuration: an OAuth client is tied to
// a bundle id and to an API that lists it in GOOGLE_IOS_CLIENT_ID, so a build
// that inherited somebody else's would offer a button that always fails. Empty
// hides the button and leaves email sign-in alone. Supply it per build, e.g.
// `xcodebuild … LINONWARD_GOOGLE_CLIENT_ID=123-abc.apps.googleusercontent.com`.
LINONWARD_GOOGLE_CLIENT_ID =

// URL of the separately deployed Vite article reader. Debug points at the
// local H5 development server; Release overrides this to empty so an official
// HTTPS origin must be supplied by the release pipeline.
LINONWARD_ARTICLE_READER_URL = http:/$()/localhost:3003/
