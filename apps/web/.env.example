# Copy to apps/web/.env.local — that file is gitignored.

# Origin of apps/api, which the status page reads GET /health from. Bare origin:
# scheme, host, and port, no path.
#
# Inlined at `next build` and frozen there, so one built image cannot be
# promoted between environments. Set it per build.
#
# Leave unset and it falls back to http://localhost:3001, the API's own default
# port, so `pnpm dev` in both workspaces works with no configuration.
NEXT_PUBLIC_API_URL=http://localhost:3001
