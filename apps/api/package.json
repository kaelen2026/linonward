{
  "name": "@linonward/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @linonward/db --filter @linonward/contracts build",
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "prebuild": "pnpm --filter @linonward/db --filter @linonward/contracts build",
    "build": "tsc --outDir dist",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "pretypecheck": "pnpm --filter @linonward/db --filter @linonward/contracts build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @linonward/db --filter @linonward/contracts build",
    "test": "vitest run",
    "pretest:integration": "pnpm migrate",
    "test:integration": "vitest run src/modules/contact/repository.test.ts src/modules/content/audit.integration.test.ts src/modules/content/authorization.integration.test.ts src/shared/redis.integration.test.ts",
    "pretest:watch": "pnpm --filter @linonward/db --filter @linonward/contracts build",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo node_modules",
    "premigrate": "pnpm --filter @linonward/db build",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-validator": "0.9.0",
    "@linonward/contracts": "workspace:*",
    "@linonward/db": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "better-auth": "1.7.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.3",
    "redis": "6.2.1",
    "resend": "^6.22.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@linonward/typescript-config": "workspace:*",
    "@types/node": "24.13.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
