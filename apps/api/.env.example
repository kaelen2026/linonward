# Copy to apps/api/.env — that file is gitignored.

# Interface and port the HTTP server binds. 3001 keeps it clear of apps/www.
HOST=0.0.0.0
PORT=3001

# Reported by GET /health so a running deploy can be identified.
API_VERSION=0.0.0

# Comma-separated browser origins allowed to call the API. Bare origins only:
# scheme, host, and port, with no path and no trailing slash. Leave empty to
# serve no CORS headers at all.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Leave empty for direct development. In production list only the literal
# socket IPs of proxies that overwrite or append X-Forwarded-For.
# TRUSTED_PROXY_IPS=127.0.0.1

# Durable storage for inquiries. Leave empty to keep them in memory — fine for
# `pnpm dev`, refused when NODE_ENV=production.
DATABASE_URL=postgres://linonward:linonward@localhost:5432/linonward

# Shared rate-limit counters. Leave empty to count per process — fine for one
# replica, refused when NODE_ENV=production.
REDIS_URL=redis://localhost:6379

# Inquiry submissions allowed per client, per window.
INQUIRY_RATE_LIMIT=5
INQUIRY_RATE_WINDOW_SECONDS=3600

# Read by compose.yml only. The database and cache ports are published on
# loopback so a host-side `pnpm dev` can reach them.
POSTGRES_PASSWORD=linonward
API_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379
