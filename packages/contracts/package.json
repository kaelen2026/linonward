{
  "name": "@linonward/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contact": {
      "types": "./dist/contact.d.ts",
      "import": "./dist/contact.js"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "import": "./dist/content.js"
    },
    "./health": {
      "types": "./dist/health.d.ts",
      "import": "./dist/health.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js"
    }
  },
  "scripts": {
    "build": "tsc --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@linonward/typescript-config": "workspace:*",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
