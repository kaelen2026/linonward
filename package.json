{
  "name": "linonward",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=!@linonward/feishu",
    "dev:feishu": "pnpm --filter @linonward/feishu dev",
    "start": "turbo run start",
    "lint": "scripts/check-harmony-signing-profile.sh && biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "ios:generate": "cd apps/ios && xcodegen generate",
    "ios:build": "xcodebuild -project apps/ios/LinOnward.xcodeproj -scheme LinOnward -configuration Debug -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "ios:test": "apps/ios/scripts/test.sh",
    "android:build": "apps/android/gradlew -p apps/android :app:assembleDebug",
    "android:test": "apps/android/gradlew -p apps/android :app:testDebugUnitTest",
    "android:lint": "apps/android/gradlew -p apps/android :app:lintDebug",
    "db:generate": "pnpm --filter @linonward/db db:generate",
    "db:check": "pnpm --filter @linonward/db db:check",
    "db:studio": "pnpm --filter @linonward/db db:studio",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps postgres redis",
    "infra:logs": "docker compose logs -f postgres redis",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "turbo": "2.10.11",
    "typescript": "5.9.3"
  }
}
